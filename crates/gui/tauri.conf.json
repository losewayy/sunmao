{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "sunmao",
  "version": "0.1.0",
  "identifier": "io.github.losewayy.sunmao",
  "build": {
    "frontendDist": "../cli/src/serve/assets"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "windows": {
      "nsis": {
        "installMode": "both"
      }
    },
    "icon": ["icons/icon.png", "icons/icon.ico"]
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["sunmao"]
      }
    },
    "updater": {
      "endpoints": [],
      "pubkey": ""
    }
  }
}
